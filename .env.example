# Project 73 — server-side configuration (never put real values in git).
# Local development: copy to `.dev.vars` (git-ignored); the Worker reads it during `pnpm dev`.
# Production (OpenAI Sites / Cloudflare): set these as Worker secrets / variables.

# ── Picnic ──────────────────────────────────────────────────────────────────
# mock = labelled demo catalogue, no Picnic calls (default when no encryption key is set)
# live = real Picnic account per user via picnic-api
PICNIC_MODE=mock
PICNIC_COUNTRY_CODE=NL
# 32 random bytes, base64. Generate with: openssl rand -base64 32
# Encrypts each user's Picnic auth key (AES-GCM). Rotating it disconnects all Picnic accounts.
PICNIC_TOKEN_ENCRYPTION_KEY=
# Direct checkout through the app. Keep false unless you have tested it manually (see docs/manual-live-picnic-test.md).
# Even when true, each user must enable it in Instellingen and approve every order + bank payment.
PICNIC_CHECKOUT_ENABLED=false

# ── AI assistant (optional; without a key the assistant uses deterministic Dutch rules) ──
AI_PROVIDER=openai
# Optional model override for the assistant (defaults: gpt-5.4-mini for OpenAI, claude-haiku-5-5 for Anthropic)
AI_MODEL=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Existing Project 75 features ────────────────────────────────────────────
OPENAI_VISION_MODEL=gpt-5.4-mini
FITDAYS_SESSION_SECRET=
USDA_API_KEY=
